# Baby Buddy MX — Local / Offline Milestone 1 Defaults ($0 USD, no live credentials required)
APP_ENV=local
NEXT_PUBLIC_APP_MODE=offline
EXPO_PUBLIC_APP_MODE=offline

# Supabase (deferred to Milestone 4 — leave blank in Milestone 1)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Gemini API (deferred to Milestone 6 — strictly server/adapter-gated & disabled in Milestone 1)
GEMINI_API_KEY=
BABY_BUDDY_AI_ENABLED=false

# Vercel deployment metadata (optional, unused locally)
VERCEL_ENV=local
