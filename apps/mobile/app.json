{
  "expo": {
    "name": "Baby Buddy MX",
    "slug": "baby-buddy-mx",
    "version": "0.1.0",
    "scheme": "babybuddymx",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#FAF8F5",
      "resizeMode": "contain"
    },
    "ios": {
      "bundleIdentifier": "mx.babybuddy.app",
      "supportsTablet": true
    },
    "android": {
      "package": "mx.babybuddy.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#FAF8F5"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
