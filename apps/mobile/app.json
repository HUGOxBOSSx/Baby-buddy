{
  "expo": {
    "name": "Baby Buddy MX",
    "slug": "baby-buddy-mx",
    "version": "0.1.0",
    "scheme": "babybuddymx",
    "orientation": "portrait",
    "icon": "./assets/mascot/mascot-home.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#FAF8F5",
      "resizeMode": "contain"
    },
    "ios": {
      "bundleIdentifier": "mx.babybuddy.app",
      "supportsTablet": true
    },
    "android": {
      "package": "mx.babybuddy.app",
      "versionCode": 1,
      "permissions": [
        "POST_NOTIFICATIONS",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/mascot/mascot-home.png",
        "backgroundColor": "#FAF8F5"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "color": "#4A7C6F"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Baby Buddy MX usa tu ubicación para consultar el clima local y recomendarte la ropa adecuada para tu bebé."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
