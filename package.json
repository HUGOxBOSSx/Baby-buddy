{
  "name": "baby-buddy-mx",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "vitest run",
    "build:web": "npm run build --workspace=@baby-buddy/web",
    "export:mobile": "npm run export --workspace=@baby-buddy/mobile"
  },
  "devDependencies": {
    "@eslint/js": "~9.39.5",
    "@types/node": "^24.13.6",
    "eslint": "~9.39.5",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.56.0",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "react": "19.2.0",
    "react-dom": "19.2.0"
  }
}
